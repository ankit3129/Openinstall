{
  "name": "openinstall",
  "version": "0.9.3",
  "description": "Open-source-first bulk software installer for Windows",
  "productName": "OpenInstall",
  "main": "src/main.js",
  "author": "OpenInstall contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.js",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/winget-utils.js && node --check src/winget-runner.js && node --check src/catalog-loader.js && node --check scripts/fetch-logos.js && node scripts/validate-catalog.js && node scripts/test.js",
    "verify:winget": "node scripts/verify-winget-ids.js",
    "dist:win": "electron-builder --win nsis --publish never",
    "fetch:logos": "node scripts/fetch-logos.js"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.openinstall.desktop",
    "productName": "OpenInstall",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "OpenInstall-${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ankit3129",
        "repo": "Openinstall"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
